# Copy to .env.local and adjust. Never commit .env.local.
#
# Architecture (BFF): Browser → Next.js server (/api/*) → Go backend (/api/v1/*).
# The browser never talks to Go and never sees a Go token.

# Go backend origin, called server-side by the BFF. Required.
API_ORIGIN=http://103.150.226.7:8082

# Key for the encrypted session cookie (≥ 32 characters, random, SECRET). Required.
# Generate: openssl rand -base64 48 — changing it logs every user out.
SESSION_SECRET=

# Name of the refresh-token cookie set by the Go backend (default: refresh_token).
# GO_REFRESH_COOKIE_NAME=refresh_token

# Time zone for "today" and displayed dates (default: Asia/Jakarta).
# NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta

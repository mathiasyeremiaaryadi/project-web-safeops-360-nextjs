# Copy to .env.local and adjust.

# Backend origin (Go/Gin). Used ONLY in development, through a Next.js rewrite of /api/v1/*.
# Required in development unless NEXT_PUBLIC_API_MOCKING=enabled.
# In production the API is served from the same origin by the reverse proxy.
API_ORIGIN=http://localhost:8080

# "enabled" starts MSW in the browser (development only) with the mock accounts.
# Must be "disabled" for production builds.
NEXT_PUBLIC_API_MOCKING=disabled

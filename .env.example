# Copy to .env.local and adjust. Never commit .env.local.
#
# Architecture (BFF): Browser → Next.js server (/api/*) → Go backend (/api/v1/*).
# The browser never talks to Go and never sees a Go token.

# "enabled" (development only): the BFF talks to a built-in mock Go backend on
# http://127.0.0.1:4010 (started automatically by `pnpm dev`). API_ORIGIN is ignored and
# SESSION_SECRET is optional. Must be "disabled" for production builds.
NEXT_PUBLIC_API_MOCKING=enabled

# Go backend origin, called server-side by the BFF (e.g. an internal address).
# Required when mocking is disabled (dev with real Go, build, production).
API_ORIGIN=http://localhost:8080

# Key for the encrypted session cookie (≥ 32 characters, random, SECRET).
# Generate: openssl rand -base64 48
# Required when mocking is disabled. Changing it logs every user out.
SESSION_SECRET=

# Name of the refresh-token cookie set by the Go backend (default: refresh_token).
# GO_REFRESH_COOKIE_NAME=refresh_token

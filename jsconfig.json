{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "tests/**/*.js", "*.mjs", "*.js"],
  "exclude": ["node_modules", ".next"]
}
